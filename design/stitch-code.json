           \"surface-bright\": \"#39393c\",\n              \"outline\": \"#918fa1\",\n              \"on-error-container\": \"#ffdad6\",\n              \"primary-fixed\": \"#e2dfff\",\n              \"on-primary-container\": \"#dad7ff\",\n              \"on-secondary\": \"#3f008e\",\n              \"on-surface-variant\": \"#c7c4d8\",\n              \"secondary-fixed\": \"#eaddff\",\n              \"on-tertiary\": \"#571f00\",\n              \"tertiary-fixed\": \"#ffdbcc\",\n              \"tertiary-fixed-dim\": \"#ffb695\",\n              \"secondary-container\": \"#6001d1\",\n              \"error-container\": \"#93000a\",\n              \"on-secondary-fixed-variant\": \"#5a00c6\",\n              \"on-surface\": \"#e4e1e6\",\n              \"surface-container-high\": \"#2a2a2d\",\n              \"tertiary-container\": \"#a44100\",\n              \"on-primary\": \"#1d00a5\",\n              \"secondary-fixed-dim\": \"#d2bbff\",\n              \"on-error\": \"#690005\",\n              \"tertiary\": \"#ffb695\",\n              \"inverse-on-surface\": \"#303033\",\n              \"background\": \"#131316\",\n              \"on-primary-fixed\": \"#0f0069\",\n              \"surface-container-lowest\": \"#0e0e11\",\n              \"primary-fixed-dim\": \"#c3c0ff\",\n              \"on-tertiary-fixed-variant\": \"#7b2f00\",\n              \"surface-dim\": \"#131316\",\n              \"surface-container-highest\": \"#353438\",\n              \"on-primary-fixed-variant\": \"#3323cc\",\n              \"surface-variant\": \"#353438\",\n              \"inverse-primary\": \"#4d44e3\",\n              \"surface-tint\": \"#c3c0ff\",\n              \"outline-variant\": \"#464555\",\n              \"on-tertiary-container\": \"#ffd2be\",\n              \"on-background\": \"#e4e1e6\",\n              \"surface-container\": \"#1f1f22\",\n              \"surface\": \"#131316\",\n              \"on-secondary-fixed\": \"#25005a\",\n              \"primary-container\": \"#4f46e5\",\n              \"on-secondary-container\": \"#c9aeff\",\n              \"primary\": \"#c3c0ff\",\n              \"inverse-surface\": \"#e4e1e6\",\n              \"secondary\": \"#d2bbff\"\n            },\n            fontFamily: {\n              \"headline\": [\"Manrope\"],\n              \"body\": [\"Inter\"],\n              \"label\": [\"Inter\"]\n            },\n            borderRadius: {\"DEFAULT\": \"0.25rem\", \"lg\": \"0.5rem\", \"xl\": \"0.75rem\", \"full\": \"9999px\"},\n          },\n        },\n      }\n    </script>\n<style>\n        .glass-card {\n            background: rgba(31, 31, 34, 0.6);\n            backdrop-filter: blur(20px);\n            border: 1px solid rgba(70, 69, 85, 0.15);\n        }\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n        }\n        .hide-scrollbar::-webkit-scrollbar {\n            display: none;\n        }\n        .hide-scrollbar {\n            -ms-overflow-style: none;\n            scrollbar-width: none;\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-background text-on-surface font-body min-h-screen pb-32 selection:bg-primary-container selection:text-white\">\n<!-- TopAppBar -->\n<header class=\"fixed top-0 w-full z-50 bg-[#131316]/60 backdrop-blur-xl border-b border-white/15 shadow-[0px_20px_40px_rgba(0,0,0,0.4)] flex items-center justify-between px-6 h-16\">\n<div class=\"flex items-center gap-3\">\n<div class=\"w-8 h-8 rounded-full overflow-hidden border border-primary/20\">\n<img alt=\"用户头像\" class=\"w-full h-full object-cover\" data-alt=\"professional portrait of a young man with a friendly expression in a modern minimal studio setting\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCYNoN3WD58C7KsJa_oyL7J4rtZU3OjoFTp_-Devft6dyF4jqFK3zBTuXINekihnSYtDorLtAiobjJ3J5sI4hKYHuqzQB5Vjbrt3wMs8NW7E-WLb2ZgXem3V5ysRDf3-e8Gz_0Bb5U3MAVS8gKNunRoNjUO_mBf6HFjzJcTU9w7IHtQlJS-iEkkCW-jgAnmykiN9NsKY3ELUpHLfB6Ub25W-OZe2AUmsZxkDvZ3e3uFz38zvqN7GMq3Fm_a1BTp1FfW0gyXx16Mn-A\"/>\n</div>\n<h1 class=\"font-headline font-bold text-xl bg-gradient-to-r from-[#4F46E5] to-[#6001D1] bg-clip-text text-transparent tracking-tight\">回想 Recallo</h1>\n</div>\n<button class=\"text-[#C7C4D8] hover:opacity-80 transition-opacity active:scale-90 transition-transform\">\n<span class=\"material-symbols-outlined\">notifications</span>\n</button>\n</header>\n<main class=\"pt-24 px-6 space-y-8 max-w-5xl mx-auto\">\n<!-- Greeting Section -->\n<section class=\"space-y-1\">\n<h2 class=\"text-3xl font-headline font-bold text-on-surface tracking-tight\">早安，智学者！</h2>\n<div class=\"flex items-center gap-2 text-on-surface-variant\">\n<span class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n<p class=\"text-sm font-medium\">Recallo AI 已根据你的记忆曲线优化今日路径</p>\n</div>\n</section>\n<!-- Core AI Card -->\n<section class=\"relative group\">\n<div class=\"absolute -inset-1 bg-gradient-to-r from-primary-container to-secondary-container rounded-[2rem] blur opacity-25 group-hover:opacity-40 transition duration-1000\"></div>\n<div class=\"relative bg-gradient-to-br from-primary-container to-secondary-container p-8 rounded-[2rem] overflow-hidden shadow-2xl\">\n<div class=\"absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-white/10 rounded-full blur-3xl\"></div>\n<div class=\"relative z-10 space-y-6\">\n<div class=\"space-y-2\">\n<h3 class=\"text-2xl font-headline font-extrabold text-white\">今日 AI 复习计划已就绪</h3>\n<p class=\"text-white/80 font-medium\">剩余 <span class=\"text-white font-bold text-lg\">12</span> 个知识点待复习</p>\n</div>\n<button class=\"bg-white text-primary-container font-bold px-8 py-3 rounded-full flex items-center gap-2 hover:bg-on-primary-container hover:text-white active:scale-95 transition-all shadow-lg\">\n<span>立即开始</span>\n<span class=\"material-symbols-outlined text-sm\">arrow_forward_ios</span>\n</button>\n</div>\n<!-- Decorative AI Pattern -->\n<div class=\"absolute bottom-4 right-8 opacity-20\">\n<span class=\"material-symbols-outlined text-[8rem]\" style=\"font-variation-settings: 'FILL' 1;\">psychology</span>\n</div>\n</div>\n</section>\n<!-- Mastery Overview -->\n<section class=\"grid grid-cols-3 gap-4\">\n<div class=\"glass-card p-4 rounded-2xl flex flex-col items-center justify-center text-center space-y-1\">\n<span class=\"text-xs font-bold text-on-surface-variant uppercase tracking-widest\">当前掌握度</span>\n<span class=\"text-2xl font-headline font-extrabold text-primary\">82%</span>\n</div>\n<div class=\"glass-card p-4 rounded-2xl flex flex-col items-center justify-center text-center space-y-1\">\n<span class=\"text-xs font-bold text-on-surface-variant uppercase tracking-widest\">累计复习</span>\n<span class=\"text-2xl font-headline font-extrabold text-secondary\">450<span class=\"text-xs ml-0.5\">点</span></span>\n</div>\n<div class=\"glass-card p-4 rounded-2xl flex flex-col items-center justify-center text-center space-y-1\">\n<span class=\"text-xs font-bold text-on-surface-variant uppercase tracking-widest\">连续学习</span>\n<span class=\"text-2xl font-headline font-extrabold text-tertiary\">15<span class=\"text-xs ml-0.5\">天</span></span>\n</div>\n</section>\n<!-- Forgetting Risk Warning -->\n<section class=\"relative\">\n<div class=\"absolute inset-0 bg-error/10 rounded-2xl\"></div>\n<div class=\"relative glass-card border-error/20 p-5 rounded-2xl flex items-start gap-4\">\n<div class=\"bg-error-container text-on-error-container p-2 rounded-xl\">\n<span class=\"material-symbols-outlined\">warning</span>\n</div>\n<div class=\"space-y-1\">\n<h4 class=\"font-bold text-error\">遗忘风险预警</h4>\n<p class=\"text-sm leading-relaxed text-on-surface-variant\">高等数学 <span class=\"text-on-surface font-semibold\">3 个考点</span> 可能将在 24 小时内跌出记忆区，建议优先复习。</p>\n</div>\n</div>\n</section>\n<!-- Subject Cards -->\n<section class=\"space-y-4\">\n<div class=\"flex justify-between items-end px-1\">\n<h3 class=\"text-xl font-headline font-bold text-on-surface\">科目概览</h3>\n<button class=\"text-sm font-medium text-primary-fixed hover:underline\">查看全部</button>\n</div>\n<div class=\"flex gap-4 overflow-x-auto hide-scrollbar pb-2 -mx-6 px-6\">\n<!-- Subject 1 -->\n<div class=\"min-w-[240px] glass-card p-5 rounded-[1.5rem] space-y-4 group cursor-pointer hover:bg-surface-container-high transition-colors\">\n<div class=\"flex justify-between items-start\">\n<div class=\"w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary\">\n<span class=\"material-symbols-outlined\">translate</span>\n</div>\n<span class=\"text-sm font-bold text-on-surface\">75%</span>\n</div>\n<div class=\"space-y-2\">\n<h4 class=\"font-bold\">英语词汇</h4>\n<div class=\"w-full h-1.5 bg-surface-container-highest rounded-full overflow-hidden\">\n<div class=\"h-full bg-primary rounded-full\" style=\"width: 75%\"></div>\n</div>\n</div>\n</div>\n<!-- Subject 2 -->\n<div class=\"min-w-[240px] glass-card p-5 rounded-[1.5rem] space-y-4 group cursor-pointer hover:bg-surface-container-high transition-colors\">\n<div class=\"flex justify-between items-start\">\n<div class=\"w-10 h-10 rounded-xl bg-secondary/10 flex items-center justify-center text-secondary\">\n<span class=\"material-symbols-outlined\">account_tree</span>\n</div>\n<span class=\"text-sm font-bold text-on-surface\">60%</span>\n</div>\n<div class=\"space-y-2\">\n<h4 class=\"font-bold\">算法与数据结构</h4>\n<div class=\"w-full h-1.5 bg-surface-container-highest rounded-full overflow-hidden\">\n<div class=\"h-full bg-secondary rounded-full\" style=\"width: 60%\"></div>\n</div>\n</div>\n</div>\n<!-- Subject 3 -->\n<div class=\"min-w-[240px] glass-card p-5 rounded-[1.5rem] space-y-4 group cursor-pointer hover:bg-surface-container-high transition-colors\">\n<div class=\"flex justify-between items-start\">\n<div class=\"w-10 h-10 rounded-xl bg-tertiary/10 flex items-center justify-center text-tertiary\">\n<span class=\"material-symbols-outlined\">history_edu</span>\n</div>\n<span class=\"text-sm font-bold text-on-surface\">90%</span>\n</div>\n<div class=\"space-y-2\">\n<h4 class=\"font-bold\">近代史纲要</h4>\n<div class=\"w-full h-1.5 bg-surface-container-highest rounded-full overflow-hidden\">\n<div class=\"h-full bg-tertiary rounded-full\" style=\"width: 90%\"></div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<!-- Learning Heatmap -->\n<section class=\"space-y-4\">\n<h3 class=\"text-xl font-headline font-bold text-on-surface px-1\">复习活跃度</h3>\n<div class=\"glass-card p-6 rounded-[1.5rem] overflow-hidden\">\n<div class=\"flex justify-between text-xs text-on-surface-variant mb-4\">\n<span>9月</span><span>10月</span><span>11月</span>\n</div>\n<div class=\"grid grid-cols-[repeat(15,1fr)] gap-2\">\n<!-- Generating a sample heatmap grid -->\n<script>\n                        const gridContainer = document.currentScript.parentElement;\n                        const levels = ['bg-surface-container-highest', 'bg-primary/20', 'bg-primary/40', 'bg-primary/70', 'bg-primary'];\n                        for (let i = 0; i < 75; i++) {\n                            const level = levels[Math.floor(Math.random() * levels.length)];\n                            document.write(`<div class=\"aspect-square rounded-[2px] ${level} transition-all hover:scale-125\"></div>`);\n                        }\n                    </script>\n</div>\n<div class=\"flex items-center justify-end gap-2 mt-4 text-[10px] text-on-surface-variant font-medium\">\n<span>Less</span>\n<div class=\"flex gap-1\">\n<div class=\"w-2.5 h-2.5 bg-surface-container-highest rounded-sm\"></div>\n<div class=\"w-2.5 h-2.5 bg-primary/20 rounded-sm\"></div>\n<div class=\"w-2.5 h-2.5 bg-primary/40 rounded-sm\"></div>\n<div class=\"w-2.5 h-2.5 bg-primary/70 rounded-sm\"></div>\n<div class=\"w-2.5 h-2.5 bg-primary rounded-sm\"></div>\n</div>\n<span>More</span>\n</div>\n</div>\n</section>\n</main>\n<!-- BottomNavBar -->\n<nav class=\"fixed bottom-0 left-0 w-full z-50 bg-[#1c1c21]/60 backdrop-blur-2xl border-t border-white/10 shadow-[0_-10px_30px_rgba(0,0,0,0.5)] flex justify-around items-center px-4 pb-8 pt-3\">\n<!-- Home Active -->\n<a class=\"flex flex-col items-center justify-center text-[#E4E1E6] bg-gradient-to-br from-[#4F46E5] to-[#6001D1] rounded-2xl py-2 px-4 scale-110 transition-all duration-300\" href=\"#\">\n<span class=\"material-symbols-outlined\" style=\"font-variation-settings: 'FILL' 1;\">home</span>\n<span class=\"font-['Inter'] text-[10px] font-medium tracking-wide mt-1\">首页</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-[#C7C4D8] opacity-60 py-2 hover:text-[#4F46E5] transition-colors active:scale-95\" href=\"#\">\n<span class=\"material-symbols-outlined\">book</span>\n<span class=\"font-['Inter'] text-[10px] font-medium tracking-wide mt-1\">科目</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-[#C7C4D8] opacity-60 py-2 hover:text-[#4F46E5] transition-colors active:scale-95\" href=\"#\">\n<span class=\"material-symbols-outlined\">smart_toy</span>\n<span class=\"font-['Inter'] text-[10px] font-medium tracking-wide mt-1\">AI助手</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-[#C7C4D8] opacity-60 py-2 hover:text-[#4F46E5] transition-colors active:scale-95\" href=\"#\">\n<span class=\"material-symbols-outlined\">leaderboard</span>\n<span class=\"font-['Inter'] text-[10px] font-medium tracking-wide mt-1\">进度</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-[#C7C4D8] opacity-60 py-2 hover:text-[#4F46E5] transition-colors active:scale-95\" href=\"#\">\n<span class=\"material-symbols-outlined\">settings</span>\n<span class=\"font-['Inter'] text-[10px] font-medium tracking-wide mt-1\">设置</span>\n</a>\n</nav>\n</body></html>"}
